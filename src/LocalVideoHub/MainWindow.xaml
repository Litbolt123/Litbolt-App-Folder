<Window x:Class="LocalVideoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Video Hub"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#12141A"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
  <DockPanel>
    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#1A3A2A" Padding="16,10"
            Visibility="Collapsed" BorderBrush="#1DB954" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Download / Releases" Padding="10,6" Margin="0,0,8,0"
                  Background="#1DB954" Foreground="White" BorderThickness="0"
                  Click="UpdateBannerDownload_OnClick"/>
          <Button Content="Later" Padding="10,6"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="UpdateBannerLater_OnClick"/>
        </StackPanel>
        <TextBlock x:Name="UpdateBannerText" Text="Update available"
                   Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#161A22" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Settings" Padding="12,6"
                Background="#2A3348" Foreground="White" BorderThickness="0"
                Click="Settings_OnClick"/>
        <TextBlock Text="Local Video Hub" FontWeight="SemiBold" Foreground="White"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Root"/>
  </DockPanel>
</Window>
