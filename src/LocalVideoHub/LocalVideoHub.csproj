<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LocalVideoHub</RootNamespace>
    <AssemblyName>LocalVideoHub</AssemblyName>
    <Product>Local Video Hub</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <None Include="Assets\icon-source.png" CopyToOutputDirectory="Never" />
    <!-- Copy ico beside exe so shortcuts can point at it -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LocalVideoHub.Core\LocalVideoHub.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <UpdateWindowsShortcuts Condition="'$(UpdateWindowsShortcuts)' == ''">true</UpdateWindowsShortcuts>
  </PropertyGroup>
  <Target Name="UpdateWindowsShortcutsAfterBuild" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(UpdateWindowsShortcuts)' == 'true' and '$(GITHUB_ACTIONS)' != 'true'">
    <PropertyGroup>
      <_ShortcutSourceDir>$([System.String]::Copy('$(TargetDir)').TrimEnd('\'))</_ShortcutSourceDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\update-windows-shortcuts.ps1&quot; -SourceDir &quot;$(_ShortcutSourceDir)&quot; -AppName &quot;Local Video Hub&quot; -ExeName &quot;LocalVideoHub.exe&quot; -ProgramsFolder &quot;LocalVideoHub&quot; -SkipProcessStop"
          IgnoreExitCode="true" />
  </Target>
</Project>
