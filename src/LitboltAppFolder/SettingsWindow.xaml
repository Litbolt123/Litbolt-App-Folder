<Window x:Class="LitboltAppFolder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Litbolt's App Folder"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        Background="#0E1016"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Close" Padding="16,8" IsCancel="True"
              Background="#2A3348" Foreground="White" BorderThickness="0"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Apps" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

        <TextBlock Text="Local Music Hub" Foreground="#8890A0" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
          <Button Content="Browse…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="BrowseMusic_OnClick"/>
          <TextBox x:Name="MusicPathBox" Padding="8,6" Background="#1A1E28" Foreground="White"
                   BorderBrush="#2A3040"/>
        </DockPanel>

        <TextBlock Text="Local Video Hub" Foreground="#8890A0" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
          <Button Content="Browse…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="BrowseVideo_OnClick"/>
          <TextBox x:Name="VideoPathBox" Padding="8,6" Background="#1A1E28" Foreground="White"
                   BorderBrush="#2A3040"/>
        </DockPanel>

        <TextBlock Text="Photo Hub" Foreground="#8890A0" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
          <Button Content="Browse…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="BrowsePhoto_OnClick"/>
          <TextBox x:Name="PhotoPathBox" Padding="8,6" Background="#1A1E28" Foreground="White"
                   BorderBrush="#2A3040"/>
        </DockPanel>

        <TextBlock Text="YouTube Downloader" Foreground="#8890A0" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,20">
          <Button Content="Browse…" DockPanel.Dock="Right" Padding="10,6" Margin="8,0,0,0"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="BrowseDownloader_OnClick"/>
          <TextBox x:Name="DownloaderPathBox" Padding="8,6" Background="#1A1E28" Foreground="White"
                   BorderBrush="#2A3040"/>
        </DockPanel>

        <TextBlock Text="System tray" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="MinimizeToTrayBox" Content="Close to system tray (keep running in background)"
                  Foreground="White" Margin="0,0,0,8"/>
        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows (opens in system tray)"
                  Foreground="White" Margin="0,0,0,20"/>

        <TextBlock Text="Updates (GitHub)" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="#B0B8C8" Margin="0,0,0,12"
                   Text="Check published releases, download the setup when attached, or open the Releases page."/>

        <CheckBox x:Name="AutoCheckBox" Content="Check for updates when App Folder starts"
                  Foreground="White" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Content="Check for updates…" Padding="12,8" Margin="0,0,8,0"
                  Background="#5B8CFF" Foreground="White" BorderThickness="0"
                  Click="CheckUpdates_OnClick"/>
          <Button Content="Open Releases page" Padding="12,8"
                  Background="#2A3348" Foreground="White" BorderThickness="0"
                  Click="OpenReleases_OnClick"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#8890A0" Margin="0,0,0,12"/>

        <StackPanel x:Name="InstallerPanel" Visibility="Collapsed" Margin="0,0,0,8">
          <Button Content="Download and install…" Padding="12,8" HorizontalAlignment="Left"
                  Background="#1DB954" Foreground="White" BorderThickness="0"
                  Click="DownloadInstaller_OnClick"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
