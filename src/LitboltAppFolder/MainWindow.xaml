<Window x:Class="LitboltAppFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Litbolt's App Folder"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#0E1016"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#161A22" Padding="16,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
          <TextBlock Text="Litbolt's" FontSize="13" Foreground="#8890A0"/>
          <TextBlock Text="App Folder" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="#667088"/>
        </StackPanel>

        <ListBox x:Name="NavList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 FontSize="14"
                 SelectionChanged="NavList_OnSelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,10"/>
              <Setter Property="Margin" Value="0,0,0,4"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#2A3348"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#222836"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="UpdateBanner" Grid.Row="0" Background="#1A3A2A" Padding="16,10"
              Visibility="Collapsed" BorderBrush="#1DB954" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Download / Releases" Padding="10,6" Margin="0,0,8,0"
                    Background="#1DB954" Foreground="White" BorderThickness="0"
                    Click="UpdateBannerDownload_OnClick"/>
            <Button Content="Later" Padding="10,6"
                    Background="#2A3348" Foreground="White" BorderThickness="0"
                    Click="UpdateBannerLater_OnClick"/>
          </StackPanel>
          <TextBlock x:Name="UpdateBannerText" Text="Update available"
                     Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Background="#12151C" Padding="16,10" BorderBrush="#222836" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Settings" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0"
                    Click="SettingsButton_OnClick"/>
            <Button x:Name="UndockButton" Content="Pop tab out"
                    Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0"
                    Click="UndockButton_OnClick"
                    ToolTip="Move this module into its own window (or launch standalone)."/>
            <Button x:Name="OpenStandaloneButton" Content="Open standalone"
                    Padding="12,6"
                    Background="#5B8CFF" Foreground="White" BorderThickness="0"
                    Click="OpenStandaloneButton_OnClick"/>
          </StackPanel>
          <TextBlock x:Name="ContentTitle" Text="Home" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <ContentControl x:Name="ContentHost" Grid.Row="2"/>
    </Grid>
  </Grid>
</Window>
