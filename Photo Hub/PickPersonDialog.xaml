<Window x:Class="PhotoHub.PickPersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose person"
        Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#12141A">
  <DockPanel Margin="16">
    <TextBlock x:Name="PromptText" DockPanel.Dock="Top" Foreground="White" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" Padding="14,8" Margin="0,0,8,0"
              Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="Ok_OnClick"/>
      <Button Content="Cancel" IsCancel="True" Padding="14,8"
              Background="#2A3348" Foreground="White" BorderThickness="0"/>
    </StackPanel>
    <ListBox x:Name="PeopleBox" Background="#161A22" Foreground="White" BorderBrush="#2A3040"/>
  </DockPanel>
</Window>
