<Window x:Class="PhotoHub.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        Background="#12141A"
        ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBox x:Name="InputBox" Padding="8,6" Background="#1A1E28" Foreground="White" BorderBrush="#2A3040"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" IsDefault="True" Padding="14,8" Margin="0,0,8,0"
              Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="Ok_OnClick"/>
      <Button Content="Cancel" IsCancel="True" Padding="14,8"
              Background="#2A3348" Foreground="White" BorderThickness="0"/>
    </StackPanel>
  </StackPanel>
</Window>
