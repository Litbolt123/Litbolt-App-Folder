<Window x:Class="PhotoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Hub"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="600"
        Background="#12141A"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#161A22" Padding="12,8">
      <DockPanel>
        <TextBlock Text="Photo Hub" FontWeight="SemiBold" Foreground="White" FontSize="16"
                   VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" Text="Face sort · People · Rainmeter widget"
                   Foreground="#8890A0" VerticalAlignment="Center" FontSize="12"/>
      </DockPanel>
    </Border>

    <TabControl x:Name="MainTabs" Background="#12141A" BorderThickness="0" Margin="8">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="Bd" Background="#161A22" Margin="0,0,4,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#2A3348"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <TabItem Header="Sort new photos">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#B0B8C8" Margin="0,0,0,12"
                     Text="Pick a folder (default: iPhone Backup). New photos are face-scanned with strict matching, then copied into person folders. Originals are never moved or deleted."/>
          <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="BrowseSourceBtn" Content="Browse…" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="BrowseSource_OnClick"/>
            <TextBox x:Name="SourceFolderBox" Padding="8,6" Background="#1A1E28" Foreground="White" BorderBrush="#2A3040"/>
          </DockPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RunSortBtn" Content="Scan and sort" Padding="14,8" Margin="0,0,8,0"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="RunSort_OnClick"/>
            <ProgressBar x:Name="SortProgress" Width="280" Height="22" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="SortProgressText" Foreground="#8890A0" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Unknown faces — type a name and Assign" Foreground="White" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="UnknownFacesPanel"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="People" x:Name="PeopleTab">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="RefreshPeople_OnClick"/>
            <Button x:Name="RenamePersonBtn" Content="Rename…" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="RenamePerson_OnClick"/>
            <Button x:Name="MergePersonBtn" Content="Merge into…" Padding="12,6"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="MergePerson_OnClick"/>
          </StackPanel>
          <ListView x:Name="PeopleList" Grid.Row="1" Background="#161A22" Foreground="White"
                    BorderBrush="#2A3040" SelectionMode="Single">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Person" DisplayMemberBinding="{Binding Name}" Width="280"/>
                <GridViewColumn Header="Photos" DisplayMemberBinding="{Binding PhotoCount}" Width="80"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="Photos" x:Name="PhotosTab">
        <StackPanel Margin="16">
          <TextBlock TextWrapping="Wrap" Foreground="#B0B8C8" Margin="0,0,0,12"
                     Text="Widget photo pools live under Widget Photos. Refresh replaces widget-NN.jpg or people-NN.jpg slots only — not Featured picks from Update-FeaturedPhotos.ps1."/>
          <Button Content="Straighten Featured JPGs (EXIF)" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,8"
                  Background="#2A3348" Foreground="White" BorderThickness="0" Click="StraightenFeatured_OnClick"/>
          <Button Content="Convert HEIC → JPG in folder…" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,16"
                  Background="#2A3348" Foreground="White" BorderThickness="0" Click="ConvertHeicFolder_OnClick"/>
          <TextBlock Text="Refresh widget photo pool" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="From iPhone backup count" Foreground="#B0B8C8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="WidgetBackupCountBox" Width="48" Text="24" Padding="6,4" Background="#1A1E28" Foreground="White"/>
            <Button Content="Refresh from backup" Padding="12,6" Margin="12,0,0,0"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="RefreshWidgetFromBackup_OnClick"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Per featured person" Foreground="#B0B8C8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="WidgetPeoplePerBox" Width="48" Text="3" Padding="6,4" Background="#1A1E28" Foreground="White"/>
            <Button Content="Refresh from People" Padding="12,6" Margin="12,0,0,0"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="RefreshWidgetFromPeople_OnClick"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="iPhone" x:Name="IPhoneTab">
        <StackPanel Margin="16">
          <TextBlock TextWrapping="Wrap" Foreground="#B0B8C8" Margin="0,0,0,12"
                     Text="Sync copies new media into the backup folder. Then use Sort new photos on that folder."/>
          <DockPanel Margin="0,0,0,8">
            <Button Content="Browse…" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="BrowseIPhoneBackup_OnClick"/>
            <TextBox x:Name="IPhoneBackupBox" Padding="8,6" Background="#1A1E28" Foreground="White" BorderBrush="#2A3040"/>
          </DockPanel>
          <TextBlock x:Name="BackupStatusText" Foreground="#8890A0" Margin="0,0,0,12" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh status" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="RefreshBackupStatus_OnClick"/>
            <Button Content="Sync (headless)" Padding="12,6" Margin="0,0,8,0"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="RunHeadlessSync_OnClick"/>
            <Button Content="Open sync app" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="LaunchSyncGui_OnClick"/>
            <Button Content="Sort backup in Photo Hub" Padding="12,6"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="GoSortAfterSync_OnClick"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Find" x:Name="FindTab">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,8">
            <TextBox x:Name="FindPersonBox" Margin="0,0,8,8" Padding="8,6" Background="#1A1E28" Foreground="White"
                     ToolTip="Person folder name contains…"/>
            <TextBox x:Name="FindPairBox" Margin="0,0,0,8" Padding="8,6" Background="#1A1E28" Foreground="White"
                     ToolTip="Pair hint (optional)"/>
            <TextBox x:Name="FindYearBox" Margin="0,0,8,0" Padding="8,6" Background="#1A1E28" Foreground="White"
                     ToolTip="Year (file creation)"/>
            <TextBox x:Name="FindFileBox" Padding="8,6" Background="#1A1E28" Foreground="White"
                     ToolTip="File name contains…"/>
          </UniformGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Search face-groups" Padding="12,6" Margin="0,0,8,0"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="FindPhotos_OnClick"/>
            <Button Content="Open in Explorer" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="OpenFindResult_OnClick"/>
            <TextBlock x:Name="FindStatusText" Foreground="#8890A0" VerticalAlignment="Center"/>
          </StackPanel>
          <ListView x:Name="FindResults" Grid.Row="2" Background="#161A22" Foreground="White" BorderBrush="#2A3040">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Person" DisplayMemberBinding="{Binding Person}" Width="200"/>
                <GridViewColumn Header="Year" DisplayMemberBinding="{Binding Year}" Width="60"/>
                <GridViewColumn Header="File" DisplayMemberBinding="{Binding FileName}" Width="320"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="Undo" x:Name="UndoTab">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh list" Padding="12,6" Margin="0,0,8,0"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="RefreshUndoList_OnClick"/>
            <Button Content="Undo selected" Padding="12,6"
                    Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="UndoSelected_OnClick"/>
          </StackPanel>
          <ListView x:Name="UndoList" Grid.Row="1" Background="#161A22" Foreground="White" BorderBrush="#2A3040">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Kind" Width="70">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Kind}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="From" DisplayMemberBinding="{Binding Source}" Width="280"/>
                <GridViewColumn Header="To" DisplayMemberBinding="{Binding Destination}" Width="280"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="Widget" x:Name="WidgetTab">
        <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#B0B8C8" Margin="0,0,0,12"
                       Text="Featured people, Rainmeter sliders, and excludes. Save updates featured-people.txt. Update widget runs Update-FeaturedPhotos.ps1."/>
            <CheckBox x:Name="PhotoWidgetOnCheck" Content="Photo Widget visible on desktop" Foreground="White" Margin="0,0,0,8"
                      Checked="PhotoWidgetOnCheck_Changed" Unchecked="PhotoWidgetOnCheck_Changed"/>
            <TextBlock x:Name="CurrentWidgetPhotoText" Foreground="#8890A0" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button Content="Hide current widget photo (exclude file name)" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Background="#2A3348" Foreground="White" BorderThickness="0" Click="HideCurrentWidgetPhoto_OnClick"/>
            <TextBlock Text="People" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl x:Name="WidgetPeopleChecks"/>
            <TextBlock Text="Pairs with August" Foreground="White" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <ItemsControl x:Name="WidgetPairChecks"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
              <Button Content="Add single photo…" Padding="12,6" Margin="0,0,8,0"
                      Background="#2A3348" Foreground="White" BorderThickness="0" Click="AddWidgetPhoto_OnClick"/>
              <Button Content="Save featured list" Padding="12,6" Margin="0,0,8,0"
                      Background="#E8A04A" Foreground="#1A1A1A" BorderThickness="0" Click="SaveFeatured_OnClick"/>
              <Button Content="Update widget" Padding="12,6"
                      Background="#2A3348" Foreground="White" BorderThickness="0" Click="UpdateWidget_OnClick"/>
            </StackPanel>
            <TextBlock Text="Excluded file names" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal">
              <ListBox x:Name="ExcludeList" Width="280" Height="100" Background="#161A22" Foreground="White" Margin="0,0,8,0"/>
              <Button Content="Remove exclude" Padding="10,6" VerticalAlignment="Top"
                      Background="#2A3348" Foreground="White" BorderThickness="0" Click="RemoveExclude_OnClick"/>
            </StackPanel>
            <TextBlock Text="Pinned photos" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ListBox x:Name="PinnedList" Height="80" Background="#161A22" Foreground="White" Margin="0,0,0,12"/>
            <TextBlock Text="Widget.ini" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <TextBlock Text="Size" Foreground="White" Width="64" VerticalAlignment="Center"/>
              <Slider x:Name="WidgetSizeSlider" Width="220" Minimum="160" Maximum="480" Value="320"
                      ValueChanged="WidgetIni_OnChanged"/>
              <TextBlock x:Name="WidgetSizeLabel" Foreground="#8890A0" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <TextBlock Text="Seconds" Foreground="White" Width="64" VerticalAlignment="Center"/>
              <Slider x:Name="WidgetSecondsSlider" Width="220" Minimum="15" Maximum="300" Value="60"
                      ValueChanged="WidgetIni_OnChanged"/>
              <TextBlock x:Name="WidgetSecondsLabel" Foreground="#8890A0" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
              <TextBlock Text="Radius" Foreground="White" Width="64" VerticalAlignment="Center"/>
              <Slider x:Name="WidgetRadiusSlider" Width="220" Minimum="0" Maximum="80" Value="28"
                      ValueChanged="WidgetIni_OnChanged"/>
              <TextBlock x:Name="WidgetRadiusLabel" Foreground="#8890A0" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="illustro skins" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel x:Name="IllustroChecksPanel"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Log">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Content="Clear" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"
                  Background="#2A3348" Foreground="White" BorderThickness="0" Click="ClearLog_OnClick"/>
          <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Background="#0E1016" Foreground="#D8DCE8"
                   BorderBrush="#2A3040" FontFamily="Consolas" FontSize="13"/>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
